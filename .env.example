# npm start generates private machine credentials; the local first-run page sets the administrator.
# PORT is the internal listener. Public URLs never select a listening port.
PORT=5310
CENTER_PORT=5310
ADMIN_SETUP_PORT=5313
PRODUCTS_CONFIG=config/products.json
NODE_ENV=development
HOST=127.0.0.1
CASDOOR_PORT=5300
CASDOOR_BACKEND_PORT=5305
CASDOOR_URL=http://localhost:5300
CENTER_URL=http://localhost:5310
BEADGRID_URL=http://localhost:5311
FOCUSTAKE_URL=http://localhost:5312
DATABASE_URL=postgresql://entitlements:GENERATE@127.0.0.1:5342/entitlements
CASDOOR_DB_PASSWORD=GENERATE
POSTGRES_PASSWORD=GENERATE
ENTITLEMENTS_DB_PASSWORD=GENERATE
CASDOOR_CENTER_CLIENT_ID=GENERATE
CASDOOR_CENTER_CLIENT_SECRET=GENERATE
CASDOOR_ADMIN_CLIENT_ID=GENERATE
CASDOOR_ADMIN_CLIENT_SECRET=GENERATE
CASDOOR_BEADGRID_CLIENT_ID=GENERATE
CASDOOR_BEADGRID_CLIENT_SECRET=GENERATE
CASDOOR_FOCUSTAKE_CLIENT_ID=GENERATE
CASDOOR_FOCUSTAKE_CLIENT_SECRET=GENERATE
BEADGRID_SERVICE_KEY=GENERATE
FOCUSTAKE_SERVICE_KEY=GENERATE
BEADGRID_DB_PASSWORD=GENERATE_64_HEX
FOCUSTAKE_DB_PASSWORD=GENERATE_64_HEX
ADMIN_SUB=GENERATE
REDEMPTION_PEPPER=GENERATE
