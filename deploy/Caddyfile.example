# Template only: no DNS, certificate requests or server changes were performed in this task.
# Replace the identity hostname and product hostnames with the approved deployment plan.
accounts.shizibandu.icu {
    encode zstd gzip
    # /admin: unified frontend; /admin/api: identity proxy; /api: business API
    reverse_proxy 127.0.0.1:5310
}
identity.accounts.shizibandu.icu {
    encode zstd gzip
    # Public issuer stays here; raw Casdoor 5305 is loopback-only.
    reverse_proxy 127.0.0.1:5300
}
