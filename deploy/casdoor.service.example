[Unit]
Description=Casdoor v4.22.0 (official release)
After=network-online.target docker.service

[Service]
User=zhenyi
Group=zhenyi
WorkingDirectory=/opt/zhenyi-accounts/.local/casdoor
ExecStart=/opt/zhenyi-accounts/.local/casdoor/casdoor
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/zhenyi-accounts/.local/casdoor/logs

[Install]
WantedBy=multi-user.target
